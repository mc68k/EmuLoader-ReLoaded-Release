// Windows resources: the program icon and the file properties (Explorer > Properties > Details).
// Made from this file by CMake (configure_file), with the version from CMakeLists.txt.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/data_template/EmuLoader.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EmuLoader community"
            VALUE "FileDescription", "@EL_PRODUCT_NAME@"
            VALUE "FileVersion", "@EL_VERSION_LABEL@ (build @EL_BUILD_REV@)"
            VALUE "InternalName", "EmuLoader-ReLoaded"
            VALUE "OriginalFilename", "EmuLoader-ReLoaded.exe"
            VALUE "ProductName", "@EL_PRODUCT_NAME@"
            VALUE "ProductVersion", "@EL_VERSION_LABEL@ (build @EL_BUILD_REV@)"
            VALUE "Comments", "A community continuation of EmuLoader, originally created by Ciro Alfredo Consentino (1974-2021)."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
